# Perfil local (dev). En Azure/prod no uses .env: los secretos van en Key Vault.
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/in_scope_db?options=-c%20timezone=America/Lima
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# SMTP (Gmail)
SPRING_MAIL_USERNAME=tu-correo@gmail.com
SPRING_MAIL_PASSWORD=tu-app-password

# CORS del frontend
IN_SCOPE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT (mínimo 32 caracteres)
IN_SCOPE_JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# BunnyCDN (solo la access key; host/zone van en application.yaml)
IN_SCOPE_BUNNY_ACCESS_KEY=your-bunny-access-key
